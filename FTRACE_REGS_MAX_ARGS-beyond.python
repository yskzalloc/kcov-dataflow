#!/usr/bin/env python3
"""
Census of kernel functions with >6 parameters -- i.e. functions whose 7th+
argument the ftrace "function args" feature cannot record.

WHY 6?  include/linux/ftrace_regs.h defines

    #ifndef FTRACE_REGS_MAX_ARGS
    # define FTRACE_REGS_MAX_ARGS  6
    #endif

No architecture overrides it (grep arch/ include/ -- only the default exists).
The function tracer, the function_graph "funcgraph-args" feature and the
BTF argument pretty-printer all cap at this value:

    kernel/trace/trace.c:2092        for (i = 0; i < FTRACE_REGS_MAX_ARGS; i++)
    kernel/trace/trace_output.c:755  /* This only prints what the arch allows (6 args by default) */
                                     if (a == FTRACE_REGS_MAX_ARGS) { trace_seq_puts(s, "..."); break; }

So a function with more than 6 arguments has its extra arguments truncated
(printed as "...").  NB: on x86_64 regs_get_kernel_argument() *could* read
stack args (n>=6 falls through to the caller stack), so the cap is a deliberate
feature limit, not a hard ABI impossibility -- but as shipped, ftrace stops at 6.

kcov_dataflow instruments at the LLVM-IR level, before ABI lowering, so it sees
every formal argument regardless of register/stack placement.  These >6-arg
functions are exactly where it adds coverage ftrace cannot.

--------------------------------------------------------------------------------
METHODOLOGY NOTES / CAVEATS (this is why the script is not a one-liner):

1. Dedup by name.  A semcode dump contains one row per (function, indexed git
   blob).  With git-history indexing enabled the same function appears many
   times, and a function defined in a .c plus declared `static inline` in a .h
   appears twice.  Counting raw rows massively over-counts (13k+ rows collapse
   to ~6.9k real functions).  We dedup by name.

2. Filter to the current HEAD tree.  dump-functions returns EVERY indexed
   version across history, including deleted/old code.  We keep only rows whose
   git_file_hash is a blob in `git ls-tree -r HEAD`, so the census reflects the
   kernel you actually have checked out.

3. "parameters" is C-source parameter count, an approximation of ABI argument-
   register count.  For scalar/pointer args (the overwhelming majority) they are
   equal.  They can differ for: by-value structs (>1 register), a hidden sret
   pointer for large-struct returns (+1), __int128 / 64-bit-on-32-bit (2 regs),
   and variadics.  So ">6 params" ~= ">6 arg registers", not a proof of it.

Usage:
    cd /path/to/linux
    semcode -q "dump-functions /tmp/funcs.json"
    git ls-tree -r HEAD | awk '$2=="blob"{print $3}' > /tmp/head_blobs.txt
    python3 FTRACE_REGS_MAX_ARGS-beyond.python /tmp/funcs.json /tmp/head_blobs.txt
"""
import json
import os
import re
import subprocess
import sys
from collections import Counter

FTRACE_MAX = 6
OUT = "/home/debian-sid/kcov-dataflow/FTRACE_REGS_MAX_ARGS-beyond.md"
LINUX_DIR = os.environ.get("LINUX_DIR", "/home/debian-sid/kcov-dataflow/linux")

def excluded(fp):
    return fp.startswith(("tools/", "samples/"))

def _git(*args):
    try:
        return subprocess.run(["git", "-C", LINUX_DIR, *args],
                              capture_output=True, text=True).stdout.strip()
    except Exception:
        return ""

def kernel_version_block():
    """Exact kernel version + SHA, anchored to the upstream mainline (master) tag."""
    mk = {}
    try:
        with open(os.path.join(LINUX_DIR, "Makefile")) as f:
            for line in f:
                m = re.match(r"(VERSION|PATCHLEVEL|SUBLEVEL|EXTRAVERSION)\s*=\s*(.*)", line)
                if m:
                    mk[m.group(1)] = m.group(2).strip()
                if len(mk) == 4:
                    break
    except OSError:
        pass
    ver = "{}.{}.{}{}".format(mk.get("VERSION", "?"), mk.get("PATCHLEVEL", "?"),
                              mk.get("SUBLEVEL", "?"), mk.get("EXTRAVERSION", ""))
    head = _git("rev-parse", "HEAD")
    describe = _git("describe", "--tags")
    # v<maj>.<min>-rcN-<N>-g<sha> -> upstream mainline base tag it descends from
    mainline_desc = _git("describe", "--tags", "--match", "v[0-9]*", "--abbrev=12", "HEAD")
    base_tag = re.sub(r"-\d+-g[0-9a-f]+$", "", mainline_desc) if mainline_desc else ""
    base_sha = _git("rev-list", "-n1", base_tag) if base_tag else ""
    lines = ["## Kernel version\n",
             f"- Version: `{ver}`",
             f"- Upstream mainline base (master): `{base_tag}` (`{base_sha}`)" if base_tag else "",
             f"- Analyzed commit (HEAD): `{head}`" + (f" (`{mainline_desc}`)" if mainline_desc else ""),
             f"- Tree: `{describe}`" if describe else ""]
    return "\n".join(l for l in lines if l) + "\n\n"

def main():
    funcs_path = sys.argv[1] if len(sys.argv) > 1 else "/tmp/funcs.json"
    blobs_path = sys.argv[2] if len(sys.argv) > 2 else "/tmp/head_blobs.txt"

    head_blobs = set(l.strip() for l in open(blobs_path) if l.strip())
    with open(funcs_path) as f:
        funcs = json.load(f)

    # (2) keep only rows present in the current HEAD tree
    # (1) dedup by name: keep max param count; prefer a .c definition over a header
    best = {}
    for func in funcs:
        if func.get("git_file_hash") not in head_blobs:
            continue
        fp = func.get("file_path", "")
        if excluded(fp):
            continue
        name = func["name"]
        p = len(func.get("parameters", []))
        cur = best.get(name)
        if (cur is None or p > cur[0]
                or (p == cur[0] and cur[1].endswith(".h") and not fp.endswith(".h"))):
            best[name] = (p, fp)

    over = [(n, p, fp) for n, (p, fp) in best.items() if p > FTRACE_MAX]
    over.sort(key=lambda x: (-x[1], x[0]))
    total = len(best)

    param_counts = Counter(p for _, p, _ in over)
    subsystems = Counter()
    for _, _, fp in over:
        parts = fp.split("/")
        subsystems["/".join(parts[:2]) if len(parts) >= 2 else fp] += 1

    with open(OUT, "w") as o:
        o.write("# Functions Beyond FTRACE_REGS_MAX_ARGS (>6 parameters)\n\n")
        o.write("Distinct kernel functions in the **current HEAD tree** whose 7th+\n")
        o.write("argument the ftrace function-args feature truncates (cap = "
                f"FTRACE_REGS_MAX_ARGS = {FTRACE_MAX}).\n\n")
        o.write("Deduplicated by function name; filtered to blobs in "
                "`git ls-tree -r HEAD`.\n")
        o.write("See the header of the generating script for the full methodology "
                "and caveats.\n\n")
        o.write(kernel_version_block())
        o.write("## Summary\n\n")
        o.write(f"- Distinct functions in HEAD tree: {total:,}\n")
        o.write(f"- **Distinct functions with >{FTRACE_MAX} params: {len(over):,}** "
                f"({100*len(over)/total:.2f}%)\n\n")
        o.write("## Distribution by parameter count\n\n")
        o.write("| Args | Functions | ftrace truncates |\n")
        o.write("|------|-----------|------------------|\n")
        for n in sorted(param_counts):
            o.write(f"| {n} | {param_counts[n]:,} | {n - FTRACE_MAX} |\n")
        o.write("\n> The long tail (30-63 params) is real: it is the AMD "
                "DisplayCore DML\n> code (`drivers/gpu/drm/amd/display/dc/dml/`), "
                "the kernel's canonical\n> example of the too-many-arguments "
                "anti-pattern.\n\n")
        o.write("## By subsystem (top 30)\n\n")
        o.write("| Subsystem | Count |\n|-----------|-------|\n")
        for sub, cnt in subsystems.most_common(30):
            o.write(f"| `{sub}` | {cnt} |\n")
        o.write("\n## Full list\n\n")
        o.write("| Args | Function | File |\n|------|----------|------|\n")
        for name, cnt, fp in over:
            o.write(f"| {cnt} | `{name}` | `{fp}` |\n")

    print(f"Distinct HEAD functions: {total:,}")
    print(f"Distinct functions with >{FTRACE_MAX} params: {len(over):,}")
    print(f"Output: {OUT}")

if __name__ == "__main__":
    main()

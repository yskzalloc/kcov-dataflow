# ksmbd-sandbox.config — Maximum attack surface for write-side LPE fuzzing
# All features enabled to exercise every KSMBD code path

[global]
workgroup = WORKGROUP
netbios name = FUZZHOST
map to guest = Bad User
guest account = nobody

# Protocol: SMB 3.1.1 (max feature coverage)
server min protocol = SMB2_10
server max protocol = SMB3_11
server string = ksmbdzzer

# Maximize buffer sizes (triggers large allocation paths)
smb2 max read = 8388608
smb2 max write = 8388608
smb2 max trans = 8388608
smb2 max credits = 8192
smbd max io size = 16777216

# Enable ALL advanced features
smb2 leases = yes
durable handles = yes
oplocks = yes
server multi channel support = yes
smb3 encryption = enabled
server signing = auto

# High limits (stress connection/session management)
max active sessions = 65536
max connections = 65536
max ip connections = 65536
max open files = 65536
deadtime = 0
ipc timeout = 0
restrict anonymous = 0

# Share features
share:fake_fscaps = 64

# Share 1: Full-feature write share (root-forced, all flags enabled)
[share]
path = /tmp/ksmbd_share
comment = Full feature write share
writeable = yes
read only = no
guest ok = yes
force user = root
force group = root
create mask = 0777
directory mask = 0777
force create mode = 0000
force directory mode = 0000
oplocks = yes
store dos attributes = yes
hide dot files = no
follow symlinks = yes
crossmnt = yes
inherit owner = yes
vfs objects = streams_xattr

# Share 2: ACL-enforced (exercises smb_check_perm_dacl / smbacl.c)
[aclshare]
path = /tmp/ksmbd_acl
comment = ACL enforced share
writeable = yes
read only = no
guest ok = yes
force user = fuzz
browseable = yes
valid users = fuzz
write list = fuzz
oplocks = yes
store dos attributes = yes
follow symlinks = yes
crossmnt = yes
inherit owner = yes
create mask = 0777
directory mask = 0777
# ksmbd implements only streams_xattr as a VFS object; `acl_xattr` is a Samba module
# and `continuous availability` needs persistent-handle caps this share can't satisfy —
# either made ksmbd.mountd skip the share (tree-connect → BAD_NETWORK_NAME / ENOENT, #42).
# ACLs are exercised natively (smbacl.c) via force user + valid users + the SD grains.
vfs objects = streams_xattr

# Share 3: Respects DesiredAccess (for privilege bypass testing)
# No force user — ksmbd uses actual requested access mask
[privtest]
path = /tmp/ksmbd_priv
comment = Privilege bypass testing (respects DesiredAccess)
writeable = yes
read only = no
guest ok = no
valid users = fuzz
write list = fuzz
oplocks = yes
store dos attributes = yes
vfs objects = streams_xattr
